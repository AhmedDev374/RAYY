  "confidence_thresholds": {
    "unknown_or_unclear": {
      "condition": "confidence < 0.70",
      "status": "Unknown or unclear image",
      "needs_expert": true
    },
    "possible_disease": {
      "condition": "0.70 <= confidence < 0.90",
      "status": "Possible disease detected",
      "needs_expert": true
    },
    "likely_disease": {
      "condition": "confidence >= 0.90",
      "status": "Likely disease detected",
      "needs_expert": false
    }
  },
  "intended_input_scope": {
    "description": "AgroScan is intended for close-up leaf-level disease screening.",
    "accepted_inputs": [
      "clear close-up image of one leaf",
      "leaf fills most of the image",
      "visible disease symptoms",
      "Tomato, Potato, or Pepper selected by user"
    ],
    "not_intended_for": [
      "full farm scene",
      "whole plant image from far away",
      "multiple overlapping plants",
      "very blurry image",
      "very dark image",
      "unsupported crop",
      "unsupported disease"
    ]
  },
  "safety_and_limitations": {
    "diagnosis_claim": "AI screening result only, not a guaranteed diagnosis",
    "expert_warning": "Consult an agricultural expert if the crop is valuable or symptoms spread.",
    "known_limitations": [
      "Model was formally tested on PlantVillage-style close-up leaf images.",
      "Performance on full field-style whole-plant images is not guaranteed.",
      "Softmax confidence can still be overconfident on out-of-distribution images.",
