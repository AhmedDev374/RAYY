# Backend environment configuration for local development.
# Copy this file to `backend/.env` and fill in the values you need.
# This file is read from the directory you run `uvicorn` from (backend/).

# --- Auth mode -------------------------------------------------------------
# "supabase" (default): validates the Supabase access token sent by the
#   frontend (Authorization: Bearer <token>) against Supabase's public JWKS.
#   No shared secret is needed for this — just SUPABASE_URL below.
# "legacy": validates locally-issued HS256 JWTs signed with SECRET_KEY
#   (email/password login via /api/v1/auth). Only use this if you are not
#   using the Supabase frontend flow.
AUTH_MODE=supabase

# Required when AUTH_MODE=supabase. Must match VITE_SUPABASE_URL in
# frontend/.env — this is how the backend knows which Supabase project's
# JWKS to fetch and verify tokens against.
SUPABASE_URL=https://ftaxppokgpmsnuipvvvt.supabase.co

# NOTE: SUPABASE_JWT_SECRET is NOT required and is ignored by the current
# verification path (Supabase access tokens are verified against the
# project's public JWKS, not a shared secret). It is only kept for backward
# compatibility with older .env files.
# SUPABASE_JWT_SECRET=

# Required when AUTH_MODE=legacy. Ignored in supabase mode.
SECRET_KEY=dev-secret-key-change-this

# --- Database ----------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db

# --- CORS ----------------------------------------------------------------
# Comma-separated list of allowed frontend origins for local dev.
# 5174 is included because Vite falls back to it when 5173 is already in use.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# --- ML / uploads ----------------------------------------------------------
MODEL_PATH=../ai/exports/smart_plant_doctor_model.pth
CONFIDENCE_THRESHOLD=0.70

# --- Optional integrations --------------------------------------------------
GEMINI_API_KEY=
BLYNK_AUTH_TOKEN=
BLYNK_SERVER=https://blr1.blynk.cloud

PUBLIC_API_URL=http://localhost:8000
